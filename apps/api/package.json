{
  "name": "@schoolhub/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && nest build",
    "typecheck": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && tsc --noEmit",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && nest start",
    "start:dev": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && nest start --watch",
    "start:debug": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "pnpm --filter @schoolhub/shared build && pnpm prisma:generate && nest start --watch",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "studio": "prisma studio",
    "seed": "node --import tsx/esm prisma/seed.ts",
    "finance:reset-payments": "node --import tsx/esm scripts/reset-dev-payments.ts",
    "test:e2e:2fa": "vitest run --config vitest.config.e2e.ts test/two-factor.e2e-spec.ts",
    "reset-2fa": "node --import tsx/esm prisma/reset-two-factor.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "test:e2e:recovery": "vitest run --config vitest.config.e2e.ts test/password-recovery.e2e-spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@schoolhub/shared": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.7",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "svix": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  }
}
