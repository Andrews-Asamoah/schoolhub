// Effective-dated finance configuration. Additive P0/P1 tables.
// Never treat DRAFT payroll schedules as legal statutory rates.
enum FinanceApprovalSubject {
  MANUAL_JOURNAL
  EXPENSE
  SUPPLIER_PAYMENT
  CREDIT_NOTE
  WRITE_OFF
  WAIVER
  REFUND
  PERIOD_CLOSE
  PERIOD_REOPEN
  ACCRUAL_CUTOVER
  PAYROLL_RUN
  BANK_RECONCILIATION
  BUDGET_REVISION
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FinanceBudgetControlMode {
  OFF
  WARN
  BLOCK
}

enum PayrollSettingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PayrollContributionBase {
  BASIC
  GROSS
  PENSIONABLE_ITEMS
}

model FinanceSettings {
  schoolId String @id
  baseCurrency String @default("GHS")
  fiscalYearStartMonth Int @default(1)
  allowSelfApproval Boolean @default(false)
  budgetControlMode FinanceBudgetControlMode @default(OFF)
  revenuePolicyApprovedAt DateTime?
  revenuePolicyApprovedBy String?
  p3AdjustmentsEnabled Boolean @default(false)
  p3CreditsEnabled Boolean @default(false)
  p3DeferredRevenueEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@map("finance_settings")
}

model FinanceApprovalPolicy {
  id String @id @default(cuid())
  schoolId String
  subject FinanceApprovalSubject
  minAmount Decimal @default(0) @db.Decimal(15, 2)
  requiredApprovals Int @default(1)
  approverPermission String
  @@unique([schoolId, subject, minAmount])
  @@map("finance_approval_policies")
}

model FinanceApprovalRequest {
  id String @id @default(cuid())
  schoolId String
  subject FinanceApprovalSubject
  entityType String
  entityId String
  amount Decimal? @db.Decimal(15, 2)
  payloadHash String
  status FinanceApprovalStatus @default(PENDING)
  requestedById String
  requestedAt DateTime @default(now())
  decidedById String?
  decidedAt DateTime?
  decisionNote String?
  @@index([schoolId, status, subject])
  @@index([entityType, entityId])
  @@map("finance_approval_requests")
}

model PayrollTaxSchedule {
  id String @id @default(cuid())
  schoolId String?
  name String
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  nonResidentRate Decimal @db.Decimal(6, 3)
  status PayrollSettingStatus @default(DRAFT)
  approvedById String?
  sourceNote String?
  bands PayrollTaxBand[]
  @@index([schoolId, effectiveFrom])
  @@map("payroll_tax_schedules")
}

model PayrollTaxBand {
  id String @id @default(cuid())
  scheduleId String
  position Int
  width Decimal? @db.Decimal(15, 2)
  rate Decimal @db.Decimal(6, 3)
  schedule PayrollTaxSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, position])
  @@map("payroll_tax_bands")
}

model PayrollContributionScheme {
  id String @id @default(cuid())
  schoolId String?
  key String
  label String
  trustee String?
  base PayrollContributionBase
  employeeRate Decimal @db.Decimal(6, 3)
  employerRate Decimal @db.Decimal(6, 3)
  memoRate Decimal @default(0) @db.Decimal(6, 3)
  insurableMin Decimal? @db.Decimal(15, 2)
  insurableMax Decimal? @db.Decimal(15, 2)
  employeeShareTaxDeductible Boolean @default(true)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  status PayrollSettingStatus @default(DRAFT)
  sourceNote String?
  approvedById String?
  @@index([schoolId, key, effectiveFrom])
  @@map("payroll_contribution_schemes")
}

enum PayrollResidency {
  RESIDENT
  NON_RESIDENT
}

enum DeductionKind {
  LOAN
  ADVANCE
  UNION
  OTHER
}

enum PayslipLineKind {
  EARNING
  DEDUCTION
  CONTRIBUTION
  TAX
}

model PayrollEarningType {
  id String @id @default(cuid())
  schoolId String
  code String
  name String
  taxable Boolean @default(true)
  pensionable Boolean @default(false)
  isOvertime Boolean @default(false)
  isActive Boolean @default(true)
  @@unique([schoolId, code])
  @@map("payroll_earning_types")
}

model PayrollDeductionType {
  id String @id @default(cuid())
  schoolId String
  code String
  name String
  kind DeductionKind @default(OTHER)
  isActive Boolean @default(true)
  @@unique([schoolId, code])
  @@map("payroll_deduction_types")
}

/// Effective-dated pay profile. A pay change adds a row; it never overwrites one.
/// The database also forbids overlapping dates for one person (exclusion constraint).
model StaffPayProfile {
  id String @id @default(cuid())
  schoolId String
  staffId String?
  teacherId String?
  basicSalary Decimal @db.Decimal(15, 2)
  residency PayrollResidency @default(RESIDENT)
  tin String?
  ssnitNumber String?
  schemeKeys String[] @default(["SSNIT_TIER1"])
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  createdById String?
  createdAt DateTime @default(now())
  recurringItems StaffRecurringItem[]
  loans StaffLoan[]
  @@index([schoolId, staffId, effectiveFrom])
  @@index([schoolId, teacherId, effectiveFrom])
  @@map("staff_pay_profiles")
}

model StaffRecurringItem {
  id String @id @default(cuid())
  profileId String
  earningTypeId String?
  deductionTypeId String?
  amount Decimal @db.Decimal(15, 2)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  profile StaffPayProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
  @@map("staff_recurring_items")
}

model StaffLoan {
  id String @id @default(cuid())
  schoolId String
  profileId String
  principal Decimal @db.Decimal(15, 2)
  instalment Decimal @db.Decimal(15, 2)
  balance Decimal @db.Decimal(15, 2)
  startDate DateTime @db.Date
  status String @default("ACTIVE")
  profile StaffPayProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([schoolId, status])
  @@map("staff_loans")
}

model PayslipLine {
  id String @id @default(cuid())
  payslipId String
  kind PayslipLineKind
  code String
  label String
  amount Decimal @db.Decimal(15, 2)
  taxable Boolean?
  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  @@index([payslipId])
  @@map("payslip_lines")
}

/// Shared fixed-window counter for the finance write limiter (one row per user and school).
model FinanceRateLimit {
  key String @id
  windowStart DateTime
  hits Int
  @@map("finance_rate_limits")
}
