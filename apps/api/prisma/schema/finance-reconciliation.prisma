model FinanceBankStatement {
  reconciliations FinanceBankReconciliation[] @relation("FinanceBankReconciliation_statement")
  createdBy user @relation("FinanceBankStatement_createdBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account ChartAccount @relation("FinanceBankStatement_account", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school School @relation("FinanceBankStatement_school", fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(cuid())
  schoolId String
  accountId String
  sourceBytes Bytes
  fileName String
  fileHash String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  openingBalance Decimal @db.Decimal(15,2)
  closingBalance Decimal @db.Decimal(15,2)
  mapping Json
  duplicateReviewReason String?
  createdById String
  createdAt DateTime @default(now())
  lines FinanceBankStatementLine[]
  @@unique([schoolId, accountId, fileHash])
  @@index([schoolId, accountId, startDate, endDate])
  @@map("finance_bank_statements")
}

model FinanceBankStatementLine {
  id String @id @default(cuid())
  statementId String
  rowNumber Int
  date DateTime @db.Date
  amount Decimal @db.Decimal(15,2)
  reference String?
  description String
  statement FinanceBankStatement @relation(fields: [statementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matches FinanceBankMatch[]
  @@unique([statementId, rowNumber])
  @@map("finance_bank_statement_lines")
}

model FinanceBankMatch {
  transaction Transaction @relation("FinanceBankMatch_transaction", fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy user @relation("FinanceBankMatch_createdBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account ChartAccount @relation("FinanceBankMatch_account", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school School @relation("FinanceBankMatch_school", fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(cuid())
  schoolId String
  accountId String
  reconciliationId String
  reconciliation FinanceBankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statementLineId String
  transactionId String
  amount Decimal @db.Decimal(15,2)
  createdById String
  createdAt DateTime @default(now())
  statementLine FinanceBankStatementLine @relation(fields: [statementLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([reconciliationId, statementLineId, transactionId])
  @@index([schoolId, accountId, transactionId])
  @@map("finance_bank_matches")
}

model FinanceBankReconciliation {
  decidedBy user? @relation("FinanceBankReconciliation_decidedBy", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  statement FinanceBankStatement @relation("FinanceBankReconciliation_statement", fields: [statementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy user @relation("FinanceBankReconciliation_createdBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account ChartAccount @relation("FinanceBankReconciliation_account", fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school School @relation("FinanceBankReconciliation_school", fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(cuid())
  schoolId String
  accountId String
  statementId String
  version Int @default(1)
  supersedesId String? @unique
  supersedes FinanceBankReconciliation? @relation("BankRevision", fields: [supersedesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy FinanceBankReconciliation? @relation("BankRevision")
  matches FinanceBankMatch[]
  @@unique([statementId, version])
  periodEnd DateTime @db.Date
  status String @default("DRAFT")
  createdById String
  submittedAt DateTime?
  decidedById String?
  decidedAt DateTime?
  decisionNote String?
  /// True when the school's setting let the preparer complete the approval step.
  waivedByPolicy Boolean @default(false)
  snapshot Json?
  contentHash String?
  createdAt DateTime @default(now())
  @@index([schoolId, accountId, periodEnd, status])
  @@map("finance_bank_reconciliations")
}
