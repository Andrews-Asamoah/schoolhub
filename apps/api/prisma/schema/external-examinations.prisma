// BECE/WAEC examination records entered by authorised school staff.
// There are intentionally no student/guardian relations or family-facing endpoints.
enum ExternalExamStatus {
  DRAFT
  OPEN
  LOCKED
}
enum ExternalResultStatus {
  GRADED
  ABSENT
  WITHHELD
  CANCELLED
}
model ExternalExamSession {
  id String @id @default(cuid())
  schoolId String
  academicYearId String
  classId String
  examYear Int
  name String @db.VarChar(120)
  status ExternalExamStatus @default(DRAFT)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  openedAt DateTime?
  lockedAt DateTime?
  lockedById String?

  school School @relation(fields: [schoolId],references: [id],onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId],references:[id])
  class Class @relation(fields:[classId],references:[id])
  createdBy user? @relation("ExternalExamCreator",fields:[createdById],references:[id],onDelete:SetNull)
  lockedBy user? @relation("ExternalExamLocker",fields:[lockedById],references:[id],onDelete:SetNull)
  candidates ExternalExamCandidate[]
  papers ExternalExamPaper[]
  imports ExternalExamImport[]

  @@unique([schoolId,examYear,classId])
  @@index([schoolId,status,createdAt])
  @@map("external_exam_sessions")
}
model ExternalExamCandidate {
  id String @id @default(cuid())
  sessionId String
  studentId String
  nameSnapshot String @db.VarChar(200)
  admissionNumberSnapshot String? @db.VarChar(100)
  indexNumber String? @db.VarChar(60)
  version Int @default(1)
  createdAt DateTime @default(now())

  session ExternalExamSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  student Student @relation(fields:[studentId],references:[id])
  results ExternalExamResult[]

  @@unique([sessionId,studentId])
  @@unique([sessionId,indexNumber])
  @@index([studentId])
  @@map("external_exam_candidates")
}
model ExternalExamPaper {
  id String @id @default(cuid())
  sessionId String
  subjectId String
  nameSnapshot String @db.VarChar(160)
  codeSnapshot String @db.VarChar(40)
  createdAt DateTime @default(now())

  session ExternalExamSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  subject Subject @relation(fields:[subjectId],references:[id])
  results ExternalExamResult[]

  @@unique([sessionId,subjectId])
  @@map("external_exam_papers")
}
model ExternalExamResult {
  id String @id @default(cuid())
  candidateId String
  paperId String
  status ExternalResultStatus
  grade Int?
  sourceReference String @db.VarChar(200)
  version Int @default(1)
  recordedById String?
  recordedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate ExternalExamCandidate @relation(fields:[candidateId],references:[id],onDelete:Cascade)
  paper ExternalExamPaper @relation(fields:[paperId],references:[id],onDelete:Cascade)
  recordedBy user? @relation("ExternalExamResultRecorder",fields:[recordedById],references:[id],onDelete:SetNull)

  @@unique([candidateId,paperId])
  @@index([paperId,status])
  @@map("external_exam_results")
}

/**
 * One successful XLSX batch: file bytes are NOT retained.
 * A single digest can be committed once per school examination session.
 */
model ExternalExamImport {
  id String @id @default(cuid())
  schoolId String
  sessionId String
  sha256 String @db.VarChar(64)
  originalFilename String @db.VarChar(160)
  rowsCommitted Int
  importedById String?
  importedAt DateTime @default(now())

  school School @relation(fields:[schoolId],references:[id],onDelete:Restrict)
  session ExternalExamSession @relation(fields:[sessionId],references:[id],onDelete:Restrict)
  importedBy user? @relation("ExternalExamImportActor",fields:[importedById],references:[id],onDelete:SetNull)

  @@unique([sessionId,sha256])
  @@index([schoolId,importedAt])
  @@map("external_exam_imports")
}
