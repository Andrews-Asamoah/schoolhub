{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Scoped native HTTP, session management and signed updates for the local main window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-request",
    "allow-desktop-select-school",
    "allow-desktop-remember-session",
    "allow-desktop-resume-session",
    "allow-desktop-forget-session",
    "allow-desktop-register-device",
    "allow-desktop-check-update",
    "allow-desktop-install-update"
  ]
}
