{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Scoped native HTTP and session management for the local main window only.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-desktop-request",
    "allow-desktop-select-school",
    "allow-desktop-remember-session",
    "allow-desktop-resume-session",
    "allow-desktop-forget-session"
  ]
}
