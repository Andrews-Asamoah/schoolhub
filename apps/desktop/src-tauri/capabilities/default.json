{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The spike window may call our own commands and make HTTP requests to the API only. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-session-get",
    "allow-session-set",
    "allow-session-clear",
    "allow-db-open",
    "allow-db-exec",
    "allow-db-query",
    "allow-db-transaction",
    "allow-db-inspect",
    "allow-db-close",
    "allow-db-wipe",
    "allow-spike-crash",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3001/*" },
        { "url": "http://127.0.0.1:4455/*" }
      ]
    }
  ]
}
