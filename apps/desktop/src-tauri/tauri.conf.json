{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchoolHub Feasibility Spike",
  "version": "0.0.0",
  "identifier": "com.schoolhub.desktop.spike",
  "build": {
    "beforeBuildCommand": "pnpm --filter @schoolhub/web build",
    "beforeDevCommand": "pnpm --filter @schoolhub/web dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SchoolHub — Feasibility Spike (synthetic data only)",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false
  }
}
