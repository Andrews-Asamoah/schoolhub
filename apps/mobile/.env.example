# Origin of the SchoolHub API, WITHOUT the /api suffix.
# Android emulator -> host machine: http://10.0.2.2:3001
# iOS simulator:                    http://localhost:3001
# Physical device:                  http://<your-LAN-ip>:3001
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Optional HTTPS web portal origin for guardian fees and verified reset links.
# Match the API's WEB_ORIGIN. See README.md for native domain association.
# EXPO_PUBLIC_PORTAL_ORIGIN=https://app.example.com
