{
  "expo": {
    "name": "SchoolHub",
    "slug": "schoolhub",
    "scheme": "schoolhub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolhub.mobile"
    },
    "android": {
      "package": "com.schoolhub.mobile",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4f5ca6dd-84fc-48dc-9409-8edb4a3f0e6e"
      }
    },
    "owner": "kingdrews"
  }
}
