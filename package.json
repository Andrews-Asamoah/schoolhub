{
  "name": "schoolhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @schoolhub/api migrate",
    "db:studio": "pnpm --filter @schoolhub/api studio",
    "db:deploy": "pnpm --filter @schoolhub/api migrate:deploy",
    "version:sync": "node scripts/release-version.mjs",
    "version:check": "node scripts/release-version.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
