# Copy to `.env` (never commit the real file) or set these in your host's secret manager.

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/schoolhub

# --- Auth -------------------------------------------------------------------
# At least 32 random characters:  openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:5173
# Set to the parent domain (e.g. .schoolhub.gh) to share the session across school subdomains.
# COOKIE_DOMAIN=

# --- API runtime ------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Number of reverse proxies in front of the API (1 = a single load balancer).
# Needed so rate limits and audit logs record the real client IP.
# TRUST_PROXY=1
# Swagger UI at /api/docs. Defaults to on in development and OFF in production.
# SWAGGER_ENABLED=false

# --- Two-factor authentication -----------------------------------------------
# Super-admins ALWAYS need it. Set to "true" to make it mandatory for school owners/admins too.
# REQUIRE_2FA_SCHOOL_ADMINS=false
# Name shown in the authenticator app (default: SchoolHub).
# TWO_FACTOR_ISSUER=SchoolHub

# --- First super-admin (used only by `pnpm --filter @schoolhub/api seed`) -----
SUPER_ADMIN_EMAIL=
# 14+ characters with upper-case, lower-case and a number. You are forced to change it at first sign-in.
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME="SchoolHub Admin"

# --- Object storage (optional; uploads return 503 when unset) ---------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
# R2_PUBLIC_URL=
