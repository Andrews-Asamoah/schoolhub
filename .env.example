# Copy to .env (never commit it). The API validates required values at start-up.

# --- Required -------------------------------------------------------------
# Local Docker Compose database from docker-compose.yml:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/schoolhub?schema=public
# At least 32 random characters:  openssl rand -base64 48
BETTER_AUTH_SECRET=
# Public URL of the API as browsers reach it (include the /api base path where applicable)
BETTER_AUTH_URL=http://localhost:3001
# Public URL of the web app
WEB_ORIGIN=http://localhost:5173
# Only domains you own. Production allows HTTPS tenant subdomains of these roots.
# TENANT_ROOT_DOMAINS=schoolhub.gh
# Web container: set https when TLS terminates at a trusted edge proxy.
# PUBLIC_SCHEME=https

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
# Number of reverse proxies in front of the API ("1" behind one load balancer,
# "2" behind a load balancer plus the web container's nginx). Needed for correct
# client IPs in rate limits and audit logs.
# TRUST_PROXY=1
# API docs: off in production unless set to "true".
# SWAGGER_ENABLED=false
# Share the session cookie across school subdomains, e.g. .schoolhub.gh
# COOKIE_DOMAIN=

# --- Security -------------------------------------------------------------
# School owners/admins require 2FA by default in production. This explicit
# value overrides the default (super-admins always need it).
# REQUIRE_2FA_SCHOOL_ADMINS=true
TWO_FACTOR_ISSUER=SchoolHub

# --- Cloudflare R2 (uploads return 503 until all are set) ------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Separate bucket: disable r2.dev and ALL public/custom-domain access.
R2_PRIVATE_BUCKET_NAME=
# Required for PDF uploads in production. Run ClamAV on a private network only.
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
R2_ENDPOINT=
# Public base URL of the bucket, e.g. https://files.example.com
R2_PUBLIC_URL=

# --- Operations -----------------------------------------------------------
# Set by the Docker image / CI. Shown in /api/health/live and the super-admin
# operations report.
# BUILD_SHA=
# The image entrypoint derives this from prisma/migrations when unset.
# EXPECTED_MIGRATION_NAME=
# Turn the nightly ledger-integrity job off (e.g. on a secondary instance).
# FINANCE_INTEGRITY_JOB=off

# --- Seeding (only used by `pnpm --filter @schoolhub/api seed`) -----------
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=

# --- Web build ------------------------------------------------------------
# Leave unset to call the API on the same origin under /api.
# VITE_API_URL=

# --- External school notifications (disabled until configured) ------------
# Rotate any previously shared key; never commit real credentials.
NOTIFICATION_DELIVERY_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@notifications.drewstechservices.com
# Signing secret for POST /api/webhooks/resend, from the Resend dashboard.
RESEND_WEBHOOK_SECRET=
# School-funded SMS credentials are entered in Notifications or SuperAdmin.
# Platform HUBTEL_CLIENT_ID / HUBTEL_CLIENT_SECRET / HUBTEL_SENDER_ID are not used.
# Required to save school credentials. Generate once: openssl rand -base64 32
# Back up this key separately from the database; never expose it to the web app.
SCHOOL_SMS_ENCRYPTION_KEY=
# Optional previous key during a controlled rotation; retain while old versions need it.
SCHOOL_SMS_PREVIOUS_ENCRYPTION_KEY=
# School owner/admin must also enable channels and daily quotas in Notifications.
# Recipients must opt in individually; verified email and Ghana mobile required.
